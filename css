/* 
 * Apex Coating East Africa Ltd - Master Stylesheet
 * Inspired by Crown Paints & Duracoat Premium Aesthetics
 */

@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap');

:root {
    --primary-navy: #0B2545;
    --primary-navy-dark: #061528;
    --accent-gold: #FFB703;
    --accent-gold-hover: #E0A000;
    --accent-teal: #139A8C;
    --accent-red: #E63946;
    --neutral-bg: #F8FAF9;
    --neutral-card: #FFFFFF;
    --neutral-border: #E2E8F0;
    --text-dark: #1E293B;
    --text-muted: #64748B;
    --text-light: #F8FAFC;
    --font-heading: 'Outfit', sans-serif;
    --font-body: 'Plus Jakarta Sans', sans-serif;
    --radius-sm: 6px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --radius-full: 9999px;
    --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.05);
    --shadow-card: 0 10px 30px rgba(11, 37, 69, 0.08);
    --shadow-hover: 0 20px 40px rgba(11, 37, 69, 0.16);
    --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Reset & Global */
*, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    font-size: 16px;
}

body {
    font-family: var(--font-body);
    background-color: var(--neutral-bg);
    color: var(--text-dark);
    line-height: 1.6;
    overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--primary-navy);
    line-height: 1.25;
}

a {
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

ul {
    list-style: none;
}

.container {
    width: 90%;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 15px;
}

/* Utility Components */
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px 28px;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    border-radius: var(--radius-full);
    border: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    text-align: center;
}

.btn-primary {
    background-color: var(--accent-gold);
    color: var(--primary-navy-dark);
    box-shadow: 0 4px 15px rgba(255, 183, 3, 0.35);
}

.btn-primary:hover {
    background-color: var(--accent-gold-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 183, 3, 0.45);
}

.btn-navy {
    background-color: var(--primary-navy);
    color: #FFFFFF;
}

.btn-navy:hover {
    background-color: var(--primary-navy-dark);
    transform: translateY(-2px);
}

.btn-outline {
    border-color: var(--primary-navy);
    color: var(--primary-navy);
    background: transparent;
}

.btn-outline:hover {
    background-color: var(--primary-navy);
    color: #FFFFFF;
}

.btn-sm {
    padding: 8px 16px;
    font-size: 0.875rem;
}

.badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.badge-gold {
    background: rgba(255, 183, 3, 0.2);
    color: #996D00;
}

.badge-navy {
    background: rgba(11, 37, 69, 0.1);
    color: var(--primary-navy);
}

.badge-teal {
    background: rgba(19, 154, 140, 0.15);
    color: var(--accent-teal);
}

.section-header {
    text-align: center;
    max-width: 750px;
    margin: 0 auto 50px;
}

.section-subtitle {
    display: inline-block;
    color: var(--accent-teal);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.875rem;
    letter-spacing: 1.5px;
    margin-bottom: 10px;
}

.section-title {
    font-size: 2.5rem;
    margin-bottom: 15px;
    color: var(--primary-navy);
}

.section-desc {
    color: var(--text-muted);
    font-size: 1.1rem;
}

/* Top Announcement Bar */
.topbar {
    background-color: var(--primary-navy-dark);
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.85rem;
    padding: 8px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.topbar-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.topbar-info {
    display: flex;
    gap: 20px;
}

.topbar-info span {
    display: flex;
    align-items: center;
    gap: 6px;
}

.topbar-controls {
    display: flex;
    align-items: center;
    gap: 15px;
}

.currency-select {
    background: rgba(255, 255, 255, 0.1);
    color: #FFF;
    border: none;
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    font-size: 0.8rem;
    cursor: pointer;
}

.currency-select option {
    background: var(--primary-navy-dark);
    color: #FFF;
}

/* Header & Navigation */
.header {
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.06);
    transition: var(--transition);
}

.navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;
}

.brand-logo {
    display: flex;
    align-items: center;
    gap: 12px;
}

.logo-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--primary-navy), var(--accent-teal));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-gold);
    font-size: 1.5rem;
    box-shadow: 0 4px 12px rgba(11, 37, 69, 0.25);
}

.brand-text h2 {
    font-size: 1.4rem;
    letter-spacing: -0.5px;
    color: var(--primary-navy);
}

.brand-text h2 span {
    color: var(--accent-teal);
}

.brand-text p {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
}

.nav-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--primary-navy);
    position: relative;
    padding: 5px 0;
}

.nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 3px;
    background: var(--accent-gold);
    border-radius: 2px;
    transition: var(--transition);
}

.nav-link:hover::after,
.nav-link.active::after {
    width: 100%;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 15px;
}

.cart-trigger {
    position: relative;
    width: 42px;
    height: 42px;
    border-radius: var(--radius-full);
    background: #F1F5F9;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--primary-navy);
    cursor: pointer;
    transition: var(--transition);
}

.cart-trigger:hover {
    background: var(--primary-navy);
    color: #FFF;
}

.cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    background: var(--accent-red);
    color: #FFF;
    font-size: 0.7rem;
    font-weight: 700;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.mobile-toggle {
    display: none;
    font-size: 1.5rem;
    color: var(--primary-navy);
    cursor: pointer;
}

/* Hero Carousel (Owl Carousel Integration) */
.hero-section {
    position: relative;
    background: var(--primary-navy-dark);
    overflow: hidden;
}

.hero-slide {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    background-size: cover;
    background-position: center;
}

.hero-slide::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(6, 21, 40, 0.92) 0%, rgba(6, 21, 40, 0.65) 55%, rgba(6, 21, 40, 0.2) 100%);
}

.hero-content {
    position: relative;
    z-index: 10;
    max-width: 650px;
    color: #FFFFFF;
    padding: 80px 0;
}

.hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 183, 3, 0.2);
    color: var(--accent-gold);
    border: 1px solid rgba(255, 183, 3, 0.4);
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 20px;
}

.hero-title {
    font-size: 3.2rem;
    color: #FFFFFF;
    margin-bottom: 20px;
    line-height: 1.15;
}

.hero-title span {
    color: var(--accent-gold);
}

.hero-subtitle {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 35px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

/* Custom Owl Carousel Controls */
.owl-theme .owl-nav {
    position: absolute;
    top: 50%;
    width: 100%;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    padding: 0 20px;
    pointer-events: none;
}

.owl-theme .owl-nav button.owl-prev,
.owl-theme .owl-nav button.owl-next {
    width: 48px;
    height: 48px;
    border-radius: 50% !important;
    background: rgba(255, 255, 255, 0.2) !important;
    backdrop-filter: blur(8px);
    color: #FFF !important;
    font-size: 1.5rem !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
    transition: var(--transition) !important;
}

.owl-theme .owl-nav button.owl-prev:hover,
.owl-theme .owl-nav button.owl-next:hover {
    background: var(--accent-gold) !important;
    color: var(--primary-navy-dark) !important;
}

.owl-theme .owl-dots {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%);
}

.owl-theme .owl-dots .owl-dot span {
    width: 12px;
    height: 12px;
    margin: 5px 6px;
    background: rgba(255, 255, 255, 0.4) !important;
    transition: var(--transition);
}

.owl-theme .owl-dots .owl-dot.active span,
.owl-theme .owl-dots .owl-dot:hover span {
    background: var(--accent-gold) !important;
    width: 32px;
    border-radius: 6px;
}

/* Features Highlights Section */
.features-section {
    padding: 60px 0;
    margin-top: -40px;
    position: relative;
    z-index: 20;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 25px;
}

.feature-card {
    background: var(--neutral-card);
    padding: 30px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    transition: var(--transition);
    display: flex;
    gap: 20px;
    align-items: flex-start;
    border: 1px solid rgba(0, 0, 0, 0.03);
}

.feature-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-hover);
    border-color: rgba(19, 154, 140, 0.2);
}

.feature-icon {
    width: 55px;
    height: 55px;
    min-width: 55px;
    border-radius: 14px;
    background: linear-gradient(135deg, rgba(11, 37, 69, 0.08), rgba(19, 154, 140, 0.15));
    color: var(--primary-navy);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
}

.feature-info h4 {
    font-size: 1.15rem;
    margin-bottom: 6px;
}

.feature-info p {
    font-size: 0.9rem;
    color: var(--text-muted);
}

/* BS 4800 Color Palette & Visualizer Section */
.colors-section {
    padding: 80px 0;
    background: #FFFFFF;
}

.visualizer-wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
    margin-top: 40px;
}

.visualizer-preview-card {
    background: var(--neutral-bg);
    border-radius: var(--radius-lg);
    padding: 25px;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--neutral-border);
    position: sticky;
    top: 100px;
}

.room-canvas-container {
    position: relative;
    width: 100%;
    height: 340px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #EAEAEA;
    box-shadow: inset 0 0 20px rgba(0,0,0,0.1);
}

.room-wall-bg {
    position: absolute;
    inset: 0;
    transition: background-color 0.4s ease;
}

.room-furniture-overlay {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    mix-blend-mode: multiply;
    pointer-events: none;
    opacity: 0.95;
}

.lighting-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 15px;
    padding-top: 15px;
    border-top: 1px solid var(--neutral-border);
}

.lighting-buttons {
    display: flex;
    gap: 8px;
}

.light-btn {
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--neutral-border);
    background: #FFF;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
}

.light-btn.active {
    background: var(--primary-navy);
    color: #FFF;
    border-color: var(--primary-navy);
}

.selected-color-meta {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 15px;
}

.color-swatch-large {
    width: 50px;
    height: 50px;
    border-radius: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    border: 2px solid #FFF;
}

.selected-color-info h3 {
    font-size: 1.2rem;
}

.selected-color-info p {
    font-size: 0.85rem;
    color: var(--text-muted);
}

/* Color Filter Tabs & Grid */
.color-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.filter-chip {
    padding: 8px 18px;
    border-radius: var(--radius-full);
    border: 1px solid var(--neutral-border);
    background: #FFF;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dark);
    cursor: pointer;
    transition: var(--transition);
}

.filter-chip:hover,
.filter-chip.active {
    background: var(--primary-navy);
    color: #FFF;
    border-color: var(--primary-navy);
}

.colors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 15px;
    max-height: 480px;
    overflow-y: auto;
    padding-right: 8px;
}

.color-card {
    background: #FFF;
    border-radius: var(--radius-md);
    padding: 12px;
    border: 2px solid transparent;
    cursor: pointer;
    transition: var(--transition);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}

.color-card:hover,
.color-card.active {
    border-color: var(--accent-gold);
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.1);
}

.color-card-chip {
    width: 100%;
    height: 65px;
    border-radius: var(--radius-sm);
    margin-bottom: 10px;
    box-shadow: inset 0 0 5px rgba(0,0,0,0.08);
}

.color-card-code {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-teal);
    letter-spacing: 0.5px;
}

.color-card-name {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--primary-navy);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* Products & Price List Section */
.products-section {
    padding: 80px 0;
    background: var(--neutral-bg);
}

.catalog-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-bottom: 30px;
    background: #FFF;
    padding: 20px;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-subtle);
}

.search-box {
    position: relative;
    flex: 1;
    min-width: 260px;
}

.search-box input {
    width: 100%;
    padding: 12px 16px 12px 42px;
    border-radius: var(--radius-full);
    border: 1px solid var(--neutral-border);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: var(--transition);
}

.search-box input:focus {
    border-color: var(--accent-teal);
    box-shadow: 0 0 0 3px rgba(19, 154, 140, 0.15);
}

.search-box i {
    position: absolute;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
}

.products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 30px;
}

.product-card {
    background: #FFF;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    border: 1px solid var(--neutral-border);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
}

.product-header {
    background: linear-gradient(135deg, var(--primary-navy), #163B66);
    color: #FFF;
    padding: 25px;
    position: relative;
}

.product-badge-pos {
    position: absolute;
    top: 20px;
    right: 20px;
}

.product-title {
    font-size: 1.3rem;
    color: #FFF;
    margin-bottom: 8px;
}

.product-tagline {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
}

.product-body {
    padding: 25px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.product-spec-list {
    margin-bottom: 20px;
}

.product-spec-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    padding: 8px 0;
    border-bottom: 1px dashed var(--neutral-border);
}

.product-spec-item span:first-child {
    color: var(--text-muted);
}

.product-spec-item span:last-child {
    font-weight: 700;
    color: var(--primary-navy);
}

.pricing-table-mini {
    background: #F8FAFC;
    border-radius: var(--radius-md);
    padding: 15px;
    margin-bottom: 20px;
}

.size-selector {
    display: flex;
    gap: 8px;
    margin-bottom: 12px;
}

.size-btn {
    flex: 1;
    padding: 8px;
    border: 1px solid var(--neutral-border);
    background: #FFF;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.85rem;
    cursor: pointer;
    text-align: center;
    transition: var(--transition);
}

.size-btn.active {
    background: var(--primary-navy);
    color: #FFF;
    border-color: var(--primary-navy);
}

.price-display {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
}

.price-amount {
    font-size: 1.6rem;
    font-weight: 800;
    font-family: var(--font-heading);
    color: var(--accent-teal);
}

.price-unit {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.product-actions {
    margin-top: auto;
    display: flex;
    gap: 10px;
}

/* Paint Quantity Calculator Section */
.calc-section {
    padding: 80px 0;
    background: linear-gradient(135deg, var(--primary-navy-dark), var(--primary-navy));
    color: #FFFFFF;
}

.calc-section .section-title,
.calc-section .section-desc {
    color: #FFFFFF;
}

.calc-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 40px;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 40px;
}

.calc-form {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
}

.form-control {
    width: 100%;
    padding: 12px 16px;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.1);
    color: #FFF;
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
}

.form-control:focus {
    border-color: var(--accent-gold);
}

.form-control option {
    background: var(--primary-navy-dark);
    color: #FFF;
}

.calc-result-box {
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.15);
}

.result-item {
    text-align: center;
    padding: 15px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.result-item:last-child {
    border-bottom: none;
}

.result-number {
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--accent-gold);
    font-family: var(--font-heading);
    line-height: 1;
    margin-bottom: 5px;
}

.result-label {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
}

/* Store Locator Section */
.stores-section {
    padding: 80px 0;
    background: #FFF;
}

.stores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 25px;
}

.store-card {
    background: var(--neutral-bg);
    border-radius: var(--radius-md);
    padding: 25px;
    border: 1px solid var(--neutral-border);
    transition: var(--transition);
}

.store-card:hover {
    border-color: var(--accent-teal);
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
}

.store-city {
    font-size: 1.2rem;
    color: var(--primary-navy);
    margin-bottom: 10px;
    display: flex;
    align-items: center;
    gap: 10px;
}

.store-detail {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
}

/* Quote Drawer / Modal */
.quote-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(6, 21, 40, 0.7);
    backdrop-filter: blur(5px);
    z-index: 2000;
    opacity: 0;
    pointer-events: none;
    transition: var(--transition);
}

.quote-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
}

.quote-drawer {
    position: fixed;
    top: 0;
    right: -450px;
    width: 100%;
    max-width: 450px;
    height: 100vh;
    background: #FFF;
    z-index: 2001;
    box-shadow: -10px 0 30px rgba(0,0,0,0.2);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
}

.quote-modal-overlay.active .quote-drawer {
    right: 0;
}

.drawer-header {
    background: var(--primary-navy);
    color: #FFF;
    padding: 20px 25px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.drawer-close {
    font-size: 1.5rem;
    color: #FFF;
    cursor: pointer;
}

.drawer-body {
    padding: 25px;
    flex: 1;
    overflow-y: auto;
}

.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px;
    background: var(--neutral-bg);
    border-radius: var(--radius-sm);
}

.cart-item-info h5 {
    font-size: 0.95rem;
}

.cart-item-info p {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.cart-item-remove {
    color: var(--accent-red);
    cursor: pointer;
    font-size: 1.1rem;
}

.drawer-footer {
    padding: 20px 25px;
    background: #F8FAFC;
    border-top: 1px solid var(--neutral-border);
}

.total-row {
    display: flex;
    justify-content: space-between;
    font-size: 1.2rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: var(--primary-navy);
}

/* Footer */
.footer {
    background: var(--primary-navy-dark);
    color: rgba(255, 255, 255, 0.75);
    padding: 70px 0 30px;
    font-size: 0.9rem;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr repeat(3, 1fr);
    gap: 40px;
    margin-bottom: 50px;
}

.footer-brand h3 {
    color: #FFF;
    font-size: 1.5rem;
    margin-bottom: 15px;
}

.footer-brand p {
    margin-bottom: 20px;
}

.footer-col h4 {
    color: #FFF;
    font-size: 1.1rem;
    margin-bottom: 20px;
}

.footer-links li {
    margin-bottom: 10px;
}

.footer-links a:hover {
    color: var(--accent-gold);
}

.copyright {
    text-align: center;
    padding-top: 30px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

/* Toast Notification */
.toast-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 3000;
}

.toast {
    background: var(--primary-navy);
    color: #FFF;
    padding: 14px 24px;
    border-radius: var(--radius-md);
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
    animation: slideInRight 0.3s forwards;
    border-left: 4px solid var(--accent-gold);
}

@keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
}

/* Responsive Media Queries */
@media (max-width: 992px) {
    .visualizer-wrapper {
        grid-template-columns: 1fr;
    }

    .calc-card {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: 1fr 1fr;
    }

    .hero-title {
        font-size: 2.4rem;
    }
}

@media (max-width: 768px) {
    .topbar-content {
        flex-direction: column;
        gap: 6px;
        text-align: center;
    }

    .mobile-toggle {
        display: block;
    }

    .nav-links {
        position: fixed;
        top: 70px;
        left: -100%;
        width: 100%;
        height: calc(100vh - 70px);
        background: #FFF;
        flex-direction: column;
        justify-content: center;
        transition: var(--transition);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1);
    }

    .nav-links.active {
        left: 0;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .form-row {
        grid-template-columns: 1fr;
    }
}
